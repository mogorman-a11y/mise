{
  "version": 2,
  "crons": [
    {
      "path": "/api/trial-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/yield-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/.*\\.md", "status": 404 },
    { "src": "/.*\\.code-workspace", "status": 404 },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/veriqo", "status": 301, "dest": "/" },
    { "src": "/veriqo-landing.html", "status": 301, "dest": "/" },
    { "src": "/carte", "status": 301, "dest": "/app" },
    { "src": "/yield-info", "status": 301, "dest": "/app" },
    { "src": "/resources", "dest": "/resources.html" },
    { "src": "/haccp", "dest": "/haccp.html" },
    { "src": "/menus", "dest": "/menus.html" },
    { "src": "/costing", "dest": "/costing.html" },
    { "src": "/prep-lists", "dest": "/prep-lists.html" },
    { "src": "/resources/(.*)", "dest": "/resources/$1.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/about/(.*)", "dest": "/about/$1.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/private-chef-pricing-calculator", "dest": "/private-chef-pricing-calculator.html" },
    { "src": "/food-temperature-guide-uk", "dest": "/food-temperature-guide-uk.html" },
    { "src": "/mise", "status": 301, "dest": "/app" },
    { "src": "/yield", "status": 301, "dest": "/app" },
    { "src": "/app", "dest": "/app.html" },
    { "src": "/pay", "dest": "/pay.html" },
    { "src": "/event", "dest": "/event.html" },
    { "src": "/client-intake", "dest": "/client-intake.html" }
  ]
}
