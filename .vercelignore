# ⚠ THIS FILE IS ADVISORY ONLY — not the source of truth for live functions.
#
# Production functions are determined by the contents of api/ in the
# GitHub-watched mise-deploy repo (github.com/mogorman-a11y/mise), which
# Vercel auto-deploys on every push to main. This .vercelignore only takes
# effect on direct `vercel deploy --prod` CLI runs from this `files/`
# directory — and those get clobbered by the next git push.
#
# To remove a function from production: delete it from mise-deploy's api/
# (or your own local clone) and push. To add one: copy it into mise-deploy's
# api/ and push. See CLAUDE.md §Deploy chain.
#
# Entries below mark files in files/api/ that are intentionally NOT mirrored
# into mise-deploy:

# Superseded by api/magic-link.js (consolidated handler since auth.js v26)
api/auth-link.js
api/carte-magic-link.js
api/yield-magic-link.js

# Paused — Stripe Connect for Yield, waiting on platform ID verification
api/stripe-connect.js

# Stub only — live checkout is the Supabase edge function. No client code calls /api/create-checkout.
api/create-checkout.js

# Merged into api/parse-menu.js (action='bio'). app.html Bio Writer already calls parse-menu.
# mise.html (retired Carte shell) still calls /api/generate-bio but mise.html is not part of the
# active app (/mise redirects to /app). Safe to exclude; see cleanup note below.
api/generate-bio.js

# Stub only — live webhook is the Supabase edge function (stripe-webhook). Stripe does not call
# the Vercel URL; no client code calls it either.
api/stripe-webhook.js

# Merged into api/veriqo-estimate.js (action='scan' branch). No client calls /api/veriqo-receipt-scan.
api/veriqo-receipt-scan.js

# Merged into api/veriqo-job.js (POST handler). No client calls /api/veriqo-reconcile.
api/veriqo-reconcile.js

